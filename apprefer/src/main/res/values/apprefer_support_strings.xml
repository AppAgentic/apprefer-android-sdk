    <!-- support.review.a11y.hint.googlePlay: VoiceOver/TalkBack hint on the review card's button. Store: Google Play (brand name, never translated). -->
    <string name="apprefer_support_review_a11y_hint_google_play">Opens Google Play</string>
    <!-- support.testimonial.reward: Line on the photo/video request card and screen. {reward} = the reward the app set, already in the customer's language (e.g. '50 bonus credits'). Taking part earns it; never imply it depends on praise. -->
    <string name="apprefer_support_testimonial_reward">For taking part: {reward}</string>
    <!-- support.testimonial.honest: Line under the ask on the photo/video request card and screen. Honest participation is what's asked; never imply praise is expected. -->
    <string name="apprefer_support_testimonial_honest">Good, bad or mixed: we want your honest take.</string>
    <!-- support.testimonial.rewardNote: Small reassurance under the reward line. The reward never depends on what is said or on allowing reuse. -->
    <string name="apprefer_support_testimonial_reward_note">You get it for taking part, whatever you say and whether or not you allow reuse.</string>
    <!-- support.testimonial.open: Button on the request card that opens the capture screen. Short. -->
    <string name="apprefer_support_testimonial_open">Share a photo or video</string>
    <!-- support.testimonial.choose: Button: pick an existing photo or video from the device's library. -->
    <string name="apprefer_support_testimonial_choose">Choose from library</string>
    <!-- support.testimonial.camera: Button: take a photo or record a video now. -->
    <string name="apprefer_support_testimonial_camera">Use camera</string>
    <!-- support.testimonial.takePhoto: Button: take a photo now with the camera (Android shows photo and video separately). -->
    <string name="apprefer_support_testimonial_take_photo">Take a photo</string>
    <!-- support.testimonial.recordVideo: Button: record a video now with the camera (Android shows photo and video separately). -->
    <string name="apprefer_support_testimonial_record_video">Record a video</string>
    <!-- support.testimonial.cameraDenied: Shown when the customer declined camera access for this app. -->
    <string name="apprefer_support_testimonial_camera_denied">Camera access is off. You can choose from your library instead.</string>
    <!-- support.testimonial.retake: Button under the preview to replace the selected photo or video. -->
    <string name="apprefer_support_testimonial_retake">Choose another</string>
    <!-- support.testimonial.publish: Label of the public-use switch, which starts on; the customer can turn it off. The app's own permission text is shown under it. -->
    <string name="apprefer_support_testimonial_publish">Allow public use</string>
    <!-- support.testimonial.publishHint: Hint under the public-use switch, which starts on. Must say it is on unless turned off, that the reward is the same either way and that permission can be withdrawn later. -->
    <string name="apprefer_support_testimonial_publish_hint">On unless you turn it off. The reward is the same either way, and you can withdraw this later.</string>
    <!-- support.testimonial.submit: Primary button that uploads and shares the selected photo or video. -->
    <string name="apprefer_support_testimonial_submit">Share</string>
    <!-- support.testimonial.uploading: Progress while uploading. {percent} = 0-100. -->
    <string name="apprefer_support_testimonial_uploading">Uploading… {percent}%</string>
    <!-- support.testimonial.checking: Shown after the upload while the server checks the file. -->
    <string name="apprefer_support_testimonial_checking">Checking…</string>
    <!-- support.testimonial.done: Title after a successful share. -->
    <string name="apprefer_support_testimonial_done">Thanks for sharing!</string>
    <!-- support.testimonial.rewardPending: After sharing, while the app hasn't confirmed the reward yet. Never promise delivery, shipping or an email. -->
    <string name="apprefer_support_testimonial_reward_pending">You\'ve earned it. It shows as confirmed here once it has been applied.</string>
    <!-- support.testimonial.rewardDone: After the app confirmed the reward (gifts, discounts, merchandise or anything handled by the app). Generic: no shipping or email promise. -->
    <string name="apprefer_support_testimonial_reward_done">Your reward is confirmed.</string>
    <!-- support.testimonial.rewardDone.account: After the app confirmed an in-account reward (credits, coach answers, subscription time). -->
    <string name="apprefer_support_testimonial_reward_done_account">Your reward has been added to your account.</string>
    <!-- support.testimonial.rewardDelayed: After sharing, when the app's confirmation failed or took too long. The support team can retry it from their inbox. -->
    <string name="apprefer_support_testimonial_reward_delayed">Your reward hasn\'t been confirmed yet. Support can see this and can send it again.</string>
    <!-- support.testimonial.rewardNotEligible: After sharing, when this customer was already rewarded for this campaign. -->
    <string name="apprefer_support_testimonial_reward_not_eligible">You\'ve already taken part in this, so there\'s no new reward this time.</string>
    <!-- support.testimonial.decline: Button to decline the request. -->
    <string name="apprefer_support_testimonial_decline">No thanks</string>
    <!-- support.testimonial.dontAsk: Button to decline and never be asked again in this app. -->
    <string name="apprefer_support_testimonial_dont_ask">Don\'t ask me again</string>
    <!-- support.testimonial.cancel: Closes the capture screen without sharing. -->
    <string name="apprefer_support_testimonial_cancel">Cancel</string>
    <!-- support.testimonial.unavailable: Shown on a request card or screen that expired, was withdrawn or belongs to another account. -->
    <string name="apprefer_support_testimonial_unavailable">This request is no longer available</string>
    <!-- support.testimonial.tooLong: Error when the chosen video is too long. {seconds} = a whole number. -->
    <string name="apprefer_support_testimonial_too_long">Videos can be up to {seconds} seconds.</string>
    <!-- support.testimonial.tooLarge: Error when the chosen file is over the size limit. -->
    <string name="apprefer_support_testimonial_too_large">This file is too large to share.</string>
    <!-- support.testimonial.failed: Error when the upload or share failed. Nothing was shared; the retry button follows. -->
    <string name="apprefer_support_testimonial_failed">Couldn\'t share it, nothing was sent. Check your connection and try again.</string>
    <!-- support.testimonial.withdraw: Button after sharing to withdraw permission for public use. -->
    <string name="apprefer_support_testimonial_withdraw">Stop public use</string>
    <!-- support.testimonial.a11y.preview: VoiceOver/TalkBack label of the preview. -->
    <string name="apprefer_support_testimonial_a11y_preview">Your selected photo or video</string>
</resources>
