    <string name="apprefer_support_review_title">Teile deine Erfahrung</string>
    <!-- support.review.body.appStore: Text on the review card. Store: App Store (brand name, never translated). -->
    <string name="apprefer_support_review_body_app_store">Wenn du möchtest, kannst du eine Bewertung im App Store schreiben.</string>
    <!-- support.review.body.googlePlay: Text on the review card. Store: Google Play (brand name, never translated). -->
    <string name="apprefer_support_review_body_google_play">Wenn du möchtest, kannst du eine Bewertung bei Google Play schreiben.</string>
