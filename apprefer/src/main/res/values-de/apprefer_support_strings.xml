    <string name="apprefer_support_testimonial_withdraw">Öffentliche Nutzung beenden</string>
    <!-- support.testimonial.a11y.preview: VoiceOver/TalkBack label of the preview. -->
    <string name="apprefer_support_testimonial_a11y_preview">Dein ausgewähltes Foto oder Video</string>
