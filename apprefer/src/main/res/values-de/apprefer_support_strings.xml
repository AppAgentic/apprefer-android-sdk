    <!-- support.testimonial.honest: Line under the ask on the photo/video request card and screen. Honest participation is what's asked; never imply praise is expected. -->
    <string name="apprefer_support_testimonial_honest">Gut, schlecht oder gemischt: Wir möchten deine ehrliche Meinung.</string>
    <!-- support.testimonial.rewardNote: Small reassurance under the reward line. The reward never depends on what is said or on allowing reuse. -->
    <string name="apprefer_support_testimonial_reward_note">Du bekommst sie fürs Mitmachen, egal was du sagst und ob du die Weiterverwendung erlaubst.</string>
    <!-- support.testimonial.open: Button on the request card that opens the capture screen. Short. -->
    <string name="apprefer_support_testimonial_open">Foto oder Video teilen</string>
    <!-- support.testimonial.choose: Button: pick an existing photo or video from the device's library. -->
    <string name="apprefer_support_testimonial_choose">Aus der Mediathek wählen</string>
    <!-- support.testimonial.camera: Button: take a photo or record a video now. -->
    <string name="apprefer_support_testimonial_camera">Kamera verwenden</string>
    <!-- support.testimonial.takePhoto: Button: take a photo now with the camera (Android shows photo and video separately). -->
    <string name="apprefer_support_testimonial_take_photo">Foto aufnehmen</string>
    <!-- support.testimonial.recordVideo: Button: record a video now with the camera (Android shows photo and video separately). -->
    <string name="apprefer_support_testimonial_record_video">Video aufnehmen</string>
    <!-- support.testimonial.cameraDenied: Shown when the customer declined camera access for this app. -->
    <string name="apprefer_support_testimonial_camera_denied">Der Kamerazugriff ist aus. Du kannst stattdessen aus deiner Mediathek wählen.</string>
    <!-- support.testimonial.retake: Button under the preview to replace the selected photo or video. -->
    <string name="apprefer_support_testimonial_retake">Anderes wählen</string>
    <!-- support.testimonial.publish: Label of the optional switch that allows the app to use the photo/video publicly (the app's own permission text is shown under it). -->
    <string name="apprefer_support_testimonial_publish">Öffentliche Nutzung erlauben</string>
    <!-- support.testimonial.publishHint: Hint under the public-use switch (which starts off). -->
    <string name="apprefer_support_testimonial_publish_hint">Freiwillig und aus, solange du es nicht einschaltest. Die Belohnung ist in beiden Fällen gleich, und du kannst es später widerrufen.</string>
    <!-- support.testimonial.submit: Primary button that uploads and shares the selected photo or video. -->
    <string name="apprefer_support_testimonial_submit">Teilen</string>
