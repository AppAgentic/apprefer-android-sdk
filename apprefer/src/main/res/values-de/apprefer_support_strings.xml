    <string name="apprefer_support_testimonial_reward_delayed">Deine Belohnung ist noch nicht bestätigt. Der Support sieht das und kann sie erneut senden.</string>
    <!-- support.testimonial.rewardNotEligible: After sharing, when this customer was already rewarded for this campaign. -->
    <string name="apprefer_support_testimonial_reward_not_eligible">Du hast hier schon mitgemacht, deshalb gibt es diesmal keine neue Belohnung.</string>
    <!-- support.testimonial.decline: Button to decline the request. -->
    <string name="apprefer_support_testimonial_decline">Nein, danke</string>
    <!-- support.testimonial.dontAsk: Button to decline and never be asked again in this app. -->
    <string name="apprefer_support_testimonial_dont_ask">Nicht mehr fragen</string>
    <!-- support.testimonial.cancel: Closes the capture screen without sharing. -->
    <string name="apprefer_support_testimonial_cancel">Abbrechen</string>
