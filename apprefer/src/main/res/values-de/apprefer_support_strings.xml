    <string name="apprefer_support_testimonial_uploading">Wird hochgeladen … {percent} %</string>
    <!-- support.testimonial.checking: Shown after the upload while the server checks the file. -->
    <string name="apprefer_support_testimonial_checking">Wird geprüft …</string>
