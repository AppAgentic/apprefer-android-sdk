<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- GAID collection (optional). Declared because we ship play-services-ads-identifier
         to match the Flutter plugin. Host app can remove this via tools:node="remove"
         if they declare a Play Data Safety non-personalized-ads posture. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Testimonial capture: find the system camera app (Android 11+ package visibility). No camera permission is declared. -->
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.media.action.VIDEO_CAPTURE" /></intent>
    </queries>
    <application>
        <provider android:name="com.apprefer.sdk.AppReferInitializer" android:authorities="${applicationId}.apprefer-init" android:exported="false" android:initOrder="100" />
        <!-- Lifecycle notifications: snooze, dismiss and re-show. Not exported: only the SDK's own PendingIntents reach it. -->
        <receiver android:name="com.apprefer.sdk.engagement.EngagementRenderer$Receiver" android:exported="false" />
        <activity android:name="com.apprefer.sdk.support.AppReferSupportActivity" android:exported="false" android:windowSoftInputMode="adjustResize" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <!-- Photo/video testimonial capture: the system photo picker or the camera app; no storage or camera permission is requested. -->
        <activity android:name="com.apprefer.sdk.support.AppReferTestimonialActivity" android:exported="false" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <!-- The camera app writes one still photo into the SDK's private cache file through a one-off grant. Not exported. -->
        <provider android:name="com.apprefer.sdk.testimonial.TestimonialMedia$CaptureProvider" android:authorities="${applicationId}.apprefer.testimonial.capture" android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
